# Choose one provider. Only its matching key is used.
# Without a key, search, map queries, and SVG conversion still work.
AI_PROVIDER=deepseek
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# For DeepSeek, set AI_PROVIDER=deepseek and add its key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# For Vercel AI Gateway, set AI_PROVIDER=vercel, add its key,
# and choose a tool-capable provider/model ID from the gateway catalog.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=

# For another OpenAI-compatible Chat Completions service, set
# AI_PROVIDER=custom. Use the API base URL, not the full /chat/completions URL.
# The service must support tool calls. Use a placeholder key for a local
# service that does not require authentication.
CUSTOM_API_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
